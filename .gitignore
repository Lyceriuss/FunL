# ---------- Dependencies ----------
node_modules/
.pnpm-store/
.yarn/*
!.yarn/releases
.npm/

# ---------- Build output ----------
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
.vite/
.cache/

# ---------- Tests & coverage ----------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
__screenshots__/
*.lcov

# ---------- Logs & debug ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Environment & secrets ----------
# Never commit real secrets. Commit `.env.example` with placeholder values instead.
.env
.env.*
!.env.example
*.local
*.pem
*.key
secrets/

# ---------- Local data / exports ----------
# Play-data exports contain children's data: keep them out of git.
funl-export-*.json
*.sqlite
*.sqlite3
*.db

# ---------- Editors & OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- AI agents ----------
# Shared agent config (CLAUDE.md, .claude/settings.json, skills) IS committed;
# personal overrides are not.
.claude/settings.local.json
.claude/*.local.*
